{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "dist",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "functions/**",
      "node_modules/**",
      ".git/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=63072000; includeSubDomains; preload"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "geolocation=(), camera=(), microphone=()"
          },
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com https://www.googletagmanager.com https://web.squarecdn.com https://apis.google.com https://*.firebaseio.com https://cdn.jsdelivr.net https://cdn.quilljs.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://cdn.quilljs.com; font-src 'self' https://fonts.gstatic.com data: https://cdn.jsdelivr.net; img-src 'self' data: blob: https://www.bigiawasaana.com https://bigiawasaana.com https://firebasestorage.googleapis.com https://*.firebasestorage.app https://*.googleusercontent.com https://maps.gstatic.com https://maps.googleapis.com; media-src 'self' data: blob: https://firebasestorage.googleapis.com https://*.firebasestorage.app; connect-src 'self' https://*.cloudfunctions.net https://*.run.app https://firestore.googleapis.com https://*.firebaseio.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.google-analytics.com https://*.google-analytics.com https://analytics.google.com https://*.google.com https://*.googleapis.com https://*.squarecdn.com https://pci-connect.squareup.com https://connect.squareup.com https://*.firebasestorage.app https://firebasestorage.googleapis.com; frame-src 'self' https://bigi-awasaana-7b3ce.firebaseapp.com https://www.google.com https://maps.google.com https://web.squarecdn.com; object-src 'none'; base-uri 'self';"
          }
        ]
      },
      {
        "source": "/.well-known/**",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/octet-stream"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|webp|avif|svg|woff|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/areas/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/syncSquareOrders",
        "function": "syncSquareOrders"
      },
      {
        "source": "/shop/item/**",
        "function": "renderRetailItemPage"
      },
      {
        "source": "/shop",
        "function": "renderShopCatalog"
      },
      {
        "source": "/shop.html",
        "function": "renderShopCatalog"
      },
      {
        "source": "/areas/**",
        "function": "renderAreaPage"
      },
      {
        "source": "/m-img/**",
        "function": "serveMenuImage"
      },
      {
        "source": "/sitemap.xml",
        "function": "renderSitemap"
      },
      {
        "source": "/blog/**",
        "function": "renderBlogPage"
      },
      {
        "source": "/blog.html",
        "function": "renderBlogIndex"
      },
      {
        "source": "/blog",
        "function": "renderBlogIndex"
      },
      {
        "source": "/item/**",
        "function": "renderItemPage"
      },
      {
        "source": "/faq",
        "destination": "/faq.html"
      },
      {
        "source": "/menu",
        "destination": "/menu.html"
      },
      {
        "source": "/review",
        "destination": "/review.html"
      },
      {
        "source": "/specials",
        "destination": "/specials.html"
      },
      {
        "source": "/locations",
        "destination": "/locations.html"
      },
      {
        "source": "/catering",
        "destination": "/catering.html"
      },
      {
        "source": "/quote",
        "destination": "/quote.html"
      },
      {
        "source": "/order-status",
        "destination": "/order-status.html"
      },
      {
        "source": "/order-history",
        "destination": "/order-history.html"
      },
      {
        "source": "/tv1",
        "destination": "/tv1.html"
      },
      {
        "source": "/tv2",
        "destination": "/tv2.html"
      },
      {
        "source": "/admin",
        "destination": "/admin.html"
      },
      {
        "source": "/admin/**",
        "destination": "/admin.html"
      },
      {
        "source": "**",
        "destination": "/404.html"
      }
    ],
    "redirects": [
      {
        "source": "/admin/orders.html",
        "destination": "/admin?view=live-orders#live-orders-view",
        "type": 302
      },
      {
        "source": "/admin/orders",
        "destination": "/admin?view=live-orders#live-orders-view",
        "type": 302
      },
      {
        "source": "/admin/order-manager",
        "destination": "/admin?view=live-orders#live-orders-view",
        "type": 302
      },
      {
        "source": "/admin/live-orders",
        "destination": "/admin?view=live-orders#live-orders-view",
        "type": 302
      },
      {
        "source": "/blog/halal-smash-burger-reseda",
        "destination": "/blog/halal-smash-burger-reseda-tarzana",
        "type": 301
      },
      {
        "source": "/blog/100-percent-zabiha-halal-meat-san-fernando-valley",
        "destination": "/blog/zabiha-halal-food-reseda-san-fernando-valley",
        "type": 301
      },
      {
        "source": "/blog/afghan-party-trays-family-catering-los-angeles",
