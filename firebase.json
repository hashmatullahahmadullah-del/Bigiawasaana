      },
      {
        "source": "/areas/sun-valley",
        "destination": "/areas/van-nuys",
        "type": 301
      },
      {
        "source": "/areas/sun-valley.html",
        "destination": "/areas/van-nuys",
        "type": 301
      },
      {
        "source": "/areas/sylmar",
        "destination": "/areas/northridge",
        "type": 301
      },
      {
