        "type": 301
      },
      {
        "source": "/areas/calabasas.html",
        "destination": "/areas/woodland-hills",
        "type": 301
      },
      {
        "source": "/areas/chatsworth",
        "destination": "/areas/west-hills",
        "type": 301
      },
      {
        "source": "/areas/chatsworth.html",
        "destination": "/areas/west-hills",
        "type": 301
      },
      {
        "source": "/areas/granada-hills",
        "destination": "/areas/northridge",
        "type": 301
      },
      {
        "source": "/areas/granada-hills.html",
        "destination": "/areas/northridge",
        "type": 301
      },
      {
        "source": "/areas/mission-hills",
        "destination": "/areas/northridge",
        "type": 301
      },
      {
        "source": "/areas/mission-hills.html",
        "destination": "/areas/northridge",
        "type": 301
      },
      {
        "source": "/areas/north-hills",
        "destination": "/areas/northridge",
        "type": 301
      },
      {
        "source": "/areas/north-hills.html",
        "destination": "/areas/northridge",
        "type": 301
      },
      {
        "source": "/areas/north-hollywood",
        "destination": "/areas/van-nuys",
        "type": 301
      },
      {
        "source": "/areas/north-hollywood.html",
        "destination": "/areas/van-nuys",
        "type": 301
      },
      {
        "source": "/areas/porter-ranch",
        "destination": "/areas/northridge",
        "type": 301
      },
      {
        "source": "/areas/porter-ranch.html",
        "destination": "/areas/northridge",
        "type": 301
      },
      {
