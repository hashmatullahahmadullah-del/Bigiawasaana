# Square Payment Configuration
# Get these from https://developer.squareup.com
VITE_SQUARE_APP_ID=your_square_app_id_here
VITE_SQUARE_LOCATION_ID=your_square_location_id_here

# Google Places API — for syncing business hours from Google Maps
# Used by the syncGoogleHours Cloud Function
# Get your API key: https://console.cloud.google.com (enable Places API New)
# Find your Place ID: https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
GOOGLE_PLACE_ID=your_google_place_id_here
