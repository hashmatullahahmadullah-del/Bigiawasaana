rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'bigiawasaana@gmail.com';
    }

    function isKds() {
      return request.auth != null && request.auth.token.kds == true;
    }

    function isAdminOrKds() {
      return isAdmin() || isKds();
    }
    
    // Menu Collection: Public read, Authenticated Admin write
    match /menu/{item} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Retail Items Collection: Public read, Authenticated Admin write
    match /retail_items/{item} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Retail Orders Collection: Authenticated Admin manage
    match /retail_orders/{order} {
      allow read, update, delete: if isAdmin();
    }
    
    // Orders Collection
    match /orders/{order} {
      // Orders are created securely via the Cloud Function. Client creation is forbidden.
      allow create: if false;
      
      // Anyone can read a SINGLE order (for tracking page)
      // But listing ALL orders requires admin or kds
      allow get: if true;
      allow list: if isAdminOrKds();
      
      // Only admins or KDS can update or delete
      // Allow status changes OR kdsHidden toggle (used by KDS dismiss button)
      allow update: if isAdminOrKds()
        && (request.resource.data.status in ['pending', 'preparing', 'ready', 'completed', 'scheduled', 'canceled']
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kdsHidden', 'updatedAt']));
            
      allow delete: if isAdmin();
    }

    // Settings Collection
    match /settings/{doc} {
      allow read: if doc in ['pickupConfig', 'popup', 'cart_promo', 'tv_promo', 'tv_display', 'kds', 'loyalty'] || isAdmin();
      allow write: if isAdmin();
    }
    
    // Live Stats
    match /liveStats/{doc} {
      allow read: if doc == 'current' || isAdmin();
      allow write: if false; // Only Cloud Functions can write
    }
    
    // Catering Inquiries Collection
    match /catering_inquiries/{inquiry} {
      // Basic validation for catering inquiries
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'phone', 'details', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 100
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 0
                    && request.resource.data.email.size() < 100
                    && request.resource.data.details is string
                    && request.resource.data.details.size() < 2000;
      allow read, update, delete: if isAdmin(); // Only admins can view and manage
    }
    
    // Deals Collection
    match /deals/{deal} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Loyalty Rewards Collection
    match /rewards/{reward} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reward Redemptions Collection
    match /redemptions/{redemption} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // Service Areas Collection (Local SEO)
    match /serviceAreas/{area} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Blog Posts Collection
    match /posts/{post} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Analytics Page Views Collection
    match /page_views/{docId} {
      allow read: if isAdmin();
      // Basic validation: must have path, timestamp, and userAgent
      allow create: if request.resource.data.keys().hasAll(['path', 'timestamp', 'userAgent']) 
                    && request.resource.data.path is string
                    && request.resource.data.path.size() < 2048;
      allow update, delete: if isAdmin();
    }
    
    // Expenses
    match /expenses/{id} {
      allow read, write: if isAdmin();
    }
    
    // Inventory and Unit Economics (Admin Only)
    match /inventory/{id} {
      allow read, write: if isAdmin();
    }
    match /unitEconomics_ingredients/{id} {
      allow read, write: if isAdmin();
    }
    match /unitEconomics_events/{id} {
      allow read, write: if isAdmin();
    }
    match /unitEconomics_platforms/{id} {
      allow read, write: if isAdmin();
    }
    match /sales_logs/{id} {
      allow read, write: if isAdmin();
    }
    
    // Reviews
    match /reviews/{id} {
      allow read: if true;
      // Basic validation: name, rating (1-5), and text limit
      allow create: if request.resource.data.keys().hasAll(['name', 'rating', 'text'])
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1 
                    && request.resource.data.rating <= 5
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 100
                    && request.resource.data.text is string
                    && request.resource.data.text.size() < 1000;
      allow update, delete: if isAdmin(); 
    }
    
    // Retail Reviews
    match /retail_reviews/{id} {
      allow read: if true;
      allow create: if false; // Only via Cloud Function
      allow update, delete: if isAdmin();
    }
    
    // Customers Collection (Managed via Cloud Functions; Admin view/manage)
    match /customers/{customer} {
      allow read, write: if isAdmin();
    }
    
    // Default: Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
